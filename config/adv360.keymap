#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
        };
    };

    macros {
        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp RS(END)>;
            label = "SELECT_LINE";
        };

        select_all: select_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(A)>;
            label = "SELECT_ALL";
        };

        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(LEFT) &kp RC(RS(RIGHT))>;
            label = "SELECT_WORD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1          &kp N2          &kp N3       &kp N4            &kp N5  &tog 1                                                                  &mo 3        &kp N6  &kp N7             &kp N8       &kp N9           &kp N0           &kp MINUS
&kp TAB    &kp Q           &kp W           &kp E        &kp R             &kp T   &none                                                                   &none        &kp Y   &kp U              &kp I        &kp O            &kp P            &kp BSLH
&kp ESC    &hm LEFT_WIN A  &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &none            &kp LCTRL  &kp LALT          &kp RIGHT_ALT  &kp RCTRL  &none        &kp H   &hm RIGHT_SHIFT J  &hm RCTRL K  &hm RIGHT_ALT L  &hm RIGHT_WIN P  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C        &kp V             &kp B                               &kp HOME          &kp RG(SPACE)                          &kp N   &kp M              &kp COMMA    &kp DOT          &kp FSLH         &kp RSHFT
&mo 2      &kp GRAVE       &kp CAPS        &kp LEFT     &kp RIGHT                 &lt 5 BACKSPACE  &kp DEL    &kp LEFT_WIN      &kp RIGHT_GUI  &kp ENTER  &lt 4 SPACE          &kp UP             &kp DOWN     &kp LBKT         &kp RBKT         &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4            &kp N5  &trans                                                   &mo 3        &kp N6  &kp KP_NUM             &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R             &kp T   &none                                                    &none        &kp Y   &kp KP_N7              &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &hm F LEFT_SHIFT  &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none        &kp H   &hm KP_N4 RIGHT_SHIFT  &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V             &kp B                        &kp HOME      &kp PG_UP                          &kp N   &kp KP_N1              &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT                 &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &lt 4 SPACE          &kp UP                 &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        sym {
            bindings = <
&trans     &kp TILDE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI           &kp COMMA     &trans                                              &trans  &trans      &trans             &trans             &trans         &trans         &trans
&kp EXCL   &kp LEFT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RIGHT_BRACKET  &kp QUESTION  &trans                                              &trans  &kp PERIOD  &kp DELETE         &kp RS(TAB)        &kp INSERT     &kp ESC        &trans
&kp POUND  &kp CARET         &kp KP_EQUAL          &kp UNDERSCORE         &kp DOLLAR         &kp ASTERISK  &trans       &trans     &trans      &trans  &trans  &trans  &kp COMMA   &kp BACKSPACE      &kp TAB            &kp SPACE      &kp ENTER      &trans
&kp TILDE  &kp LESS_THAN     &kp PIPE              &kp KP_MINUS           &kp GREATER_THAN   &kp SLASH                             &trans      &trans                  &kp SEMI    &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE   &kp TILDE      &kp BACKSLASH  &trans
&trans     &kp AMPERSAND     &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp PLUS                         &kp PERCENT  &kp COLON  &kp AT      &trans  &trans  &trans              &kp RIGHT_SHIFT    &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_WIN  &trans
            >;
        };

        cursor {
            bindings = <
&none           &kp ESCAPE    &kp INSERT    &kp LS(TAB)   &kp DEL         &none        &trans                                               &trans        &none        &none         &none           &none      &none        &none
&kp ESCAPE      &kp ENTER     &kp SPACE     &kp TAB       &kp BACKSPACE   &kp K_CUT    &trans                                               &trans        &kp RS(TAB)  &kp K_UNDO    &kp K_REDO      &kp TAB    &kp K_CUT    &none
&sk LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL     &kp LEFT_SHIFT  &kp K_COPY   &trans  &none  &none      &none        &none         &trans        &kp LEFT     &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp K_COPY   &sk RIGHT_SHIFT
&none           &select_all   &select_line  &select_word  &kp K_FIND      &kp K_PASTE                 &none      &none                                    &kp HOME     &kp PAGE_UP   &kp PAGE_DOWN   &kp END    &kp K_PASTE  &none
&none           &kp K_UNDO    &kp K_REDO    &none         &none                        &trans  &none  &none      &select_all  &select_line  &select_word               &kp K_FIND    &none           &none      &none        &none
            >;
        };

        number {
            bindings = <
&none           &kp ESCAPE    &kp INSERT    &kp LS(TAB)   &kp DEL         &none        &trans                                                  &trans  &kp PIPE    &kp POUND             &kp DOLLAR        &kp CARET          &kp TILDE              &kp EXCL
&kp ESCAPE      &kp ENTER     &kp SPACE     &kp TAB       &kp BACKSPACE   &kp K_CUT    &trans                                                  &trans  &kp PERIOD  &kp N7                &kp N8            &kp N9             &kp COLON              &kp PERCENT
&sk LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL     &kp LEFT_SHIFT  &kp K_COPY   &trans  &none   &none      &none             &none      &trans  &kp COMMA   &kp NUMBER_4          &kp N5            &kp NUMBER_6       &kp MINUS              &sk PLUS
&kp UNDER       &select_all   &select_line  &select_word  &kp K_FIND      &kp K_PASTE                  &none      &kp LESS_THAN                        &none       &kp NUMBER_1          &kp NUMBER_2      &kp NUMBER_3       &kp KP_DIVIDE          &kp KP_MULTIPLY
&none           &kp K_UNDO    &kp K_REDO    &none         &none                        &none   &trans  &none      &kp GREATER_THAN  &kp EQUAL  &kp N0              &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp AT
            >;
        };
    };
};
